{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/login",
      "dest": "dashboard/login.html"
    },
    {
      "src": "/signup",
      "dest": "dashboard/signup.html"
    },
    {
      "src": "/forgot-password",
      "dest": "dashboard/forgot-password.html"
    },
    {
      "src": "/profile",
      "dest": "dashboard/profile.html"
    },
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "outputDirectory": "dashboard"
}