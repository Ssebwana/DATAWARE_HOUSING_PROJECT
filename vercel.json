{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**",
      "use": "@vercel/static-build",
      "config": { "distDir": "." }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "dashboard/$1"
    },
    {
      "src": "/login",
      "dest": "dashboard/login.html"
    },
    {
      "src": "/signup",
      "dest": "dashboard/signup.html"
    },
    {
      "src": "/forgot-password",
      "dest": "dashboard/forgot-password.html"
    },
    {
      "src": "/profile",
      "dest": "dashboard/profile.html"
    },
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "ALGORITHM": "HS256",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "30"
  },
  "outputDirectory": "dashboard"
}